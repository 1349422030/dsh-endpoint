{
  "name": "dsh-endpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serves the models this DeepSeek Harness profile is configured for as an OpenAI-compatible HTTP endpoint, inheriting modalities, reasoning efforts, and context limits from the profile.",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/plugin.js",
    "lib/http.js",
    "lib/protocol.js",
    "lib/capabilities.js",
    "lib/chat.js",
    "lib/models.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "openai-compatible",
    "local-api"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node scripts/link-host.mjs && node --test test"
  }
}
